{
  "name": "real-world-intelligence-learning-assistant",
  "version": "0.1.0",
  "description": "AI-powered real-world intelligence and learning platform turning breaking events into structured knowledge.",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ai",
    "learning-assistant",
    "news-intelligence",
    "real-world-knowledge",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
