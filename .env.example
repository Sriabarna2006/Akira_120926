# ==============================================================================
# AKIRA INTELLIGENCE PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ==============================================================================
# 1. CLIENT-SAFE ENVIRONMENT VARIABLES (Exposed in Vite frontend bundle)
# ==============================================================================
# Base URL for API requests in the browser (defaults to relative /api when hosted on Vercel)
VITE_API_BASE_URL=/api

# Supabase Auth & Public Data Access (Public client-side keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional: Pre-configured VAPID public key (also auto-discovered via /api/notifications/vapid-public-key)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-base64

# ==============================================================================
# 2. SERVER-ONLY ENVIRONMENT VARIABLES (CRITICAL: NEVER EXPOSE TO CLIENT)
# ==============================================================================
# Runtime & Network Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-akira-frontend.vercel.app

# Primary PostgreSQL Database (Neon Serverless PostgreSQL or Supabase PG)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-pooler.region.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Tuning
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_CONNECTIONS=10

# Supabase Backend Service Role (Server-side admin access ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# AI / LLM Provider Key (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key

# Web Push Notification VAPID Server Credentials (Phase 14-17 Web Push)
VAPID_PUBLIC_KEY=your-vapid-public-key-base64
VAPID_PRIVATE_KEY=your-vapid-private-key-base64
VAPID_SUBJECT=mailto:admin@akira-intelligence.com

# Scheduled Ingestion / Cron Security Key
# Protects POST /api/live/sync and POST /api/notifications/scheduler/run
CRON_SECRET=your-internal-cron-sync-secret-key
INTERNAL_SYNC_SECRET=your-internal-cron-sync-secret-key

# News Feed Reliability & Network Guardrails
INGESTION_TIMEOUT_MS=6000
INGESTION_MAX_RETRIES=2

