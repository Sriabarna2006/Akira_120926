# Server Environment Variables (CRITICAL: Kept secret on server)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Options:
# Option A: Neon DB (Serverless PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-crimson-breeze-aetknihr-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Supabase (PostgreSQL & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# AI / LLM Provider (Backend API Key)
GEMINI_API_KEY=your-gemini-api-key

# Web Push VAPID Credentials (Phase 14 & 15 Production Required)
VAPID_PUBLIC_KEY=your-vapid-public-key-base64
VAPID_PRIVATE_KEY=your-vapid-private-key-base64
VAPID_SUBJECT=mailto:admin@akira-intelligence.com

# Serverless Scheduler & Internal Endpoint Protection (Phase 14 & 15)
CRON_SECRET=your-internal-cron-sync-secret-key

# Operational Reliability & Network Resilience (Optional Overrides)
DB_CONNECTION_TIMEOUT_MS=3500
INGESTION_TIMEOUT_MS=5000
INGESTION_MAX_RETRIES=1
